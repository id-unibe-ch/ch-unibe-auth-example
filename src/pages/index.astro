---
import Base from '../layouts/Base.astro';
import ProviderButton from '../components/ProviderButton.astro';
import { providers } from '../lib/providers';

if (Astro.locals.user) return Astro.redirect('/profile');

const direct = providers.filter((p) => p.group === 'direct');
const broker = providers.filter((p) => p.group === 'broker');
---

<Base title="Anmelden">
  <h1 class="text-2xl font-bold">Anmelden</h1>
  <p class="mt-2 max-w-2xl text-neutral-600">
    Diese Seite zeigt, wie sich verschiedene Identity Provider an eine Anwendung der Universität Bern anbinden lassen.
    Wählen Sie eine Anmeldemethode.
  </p>

  <div class="mt-4 max-w-2xl rounded-md border border-sky-200 bg-sky-50 px-4 py-3 text-sm text-sky-900">
    <strong>Bereits ein Konto?</strong> Wenn Sie sich mit einer neuen Methode anmelden, entsteht ein neues Benutzerkonto.
    Um weitere Accounts zu Ihrem bestehenden Konto hinzuzufügen, melden Sie sich zuerst wie gewohnt an und verbinden
    Sie den Account anschliessend im Profil.
  </div>

  <section class="mt-8">
    <h2 class="text-sm font-semibold uppercase tracking-wide text-neutral-500">Direkt angebunden</h2>
    <p class="mt-1 text-sm text-neutral-500">Die Anwendung ist bei jedem Provider einzeln registriert.</p>
    <div class="mt-3 grid gap-3 sm:grid-cols-2">
      {direct.map((p) => <ProviderButton provider={p} />)}
    </div>
  </section>

  <section class="mt-8">
    <h2 class="text-sm font-semibold uppercase tracking-wide text-neutral-500">Über Entra External ID</h2>
    <p class="mt-1 text-sm text-neutral-500">
      Die Anwendung kennt nur External ID; die Auswahl des eigentlichen Providers erfolgt dort.
    </p>
    <div class="mt-3 grid gap-3 sm:grid-cols-2">
      {broker.map((p) => <ProviderButton provider={p} />)}
    </div>
  </section>

  <section class="mt-8">
    <h2 class="text-sm font-semibold uppercase tracking-wide text-neutral-500">Passkey</h2>
    <div class="mt-3 grid gap-3 sm:grid-cols-2">
      <div
        aria-disabled="true"
        class="rounded-lg border border-dashed border-neutral-300 bg-neutral-100 px-4 py-3 text-neutral-500"
      >
        <span class="block font-medium">Mit Passkey anmelden</span>
        <span class="block text-xs">In Umsetzung</span>
      </div>
    </div>
  </section>
</Base>
