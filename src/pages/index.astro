---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import ProviderButton from '../components/ProviderButton.astro';
import { providerLabel, t } from '../i18n/ui';
import { providers } from '../lib/providers';

if (Astro.locals.user) return Astro.redirect('/profile');
const { locale } = Astro.locals;

const available = providers.filter((p) => p.status === 'available');
const primary = available.filter((p) => p.section === 'primary');
const academic = available.filter((p) => p.section === 'academic');
const other = available.filter((p) => p.section === 'other');
const soon = providers.filter((p) => p.status !== 'available');

const features = [
  { icon: 'link', title: 'login.feature.link.title', text: 'login.feature.link.text' },
  { icon: 'eye', title: 'login.feature.transparent.title', text: 'login.feature.transparent.text' },
  { icon: 'key', title: 'login.feature.passkeys.title', text: 'login.feature.passkeys.text' },
] as const;
---

<Base titleKey="login.title">
  <div class="flex flex-wrap items-start gap-12">
    <section class="min-w-0 flex-[1_1_380px] pt-6">
      <span class="inline-flex items-center gap-2 rounded-full border border-emerald-200 bg-emerald-50 px-3 py-1.5 text-[13px] font-medium text-emerald-800 dark:border-emerald-800 dark:bg-emerald-950 dark:text-emerald-300">
        <span class="h-1.5 w-1.5 rounded-full bg-emerald-500 dark:bg-emerald-400"></span>
        {t(locale, 'login.badge')}
      </span>
      <h1 class="mt-5 mb-4 text-4xl leading-[1.1] font-bold tracking-tight sm:text-[44px]">
        {t(locale, 'login.heading1')}<br />{t(locale, 'login.heading2')}
      </h1>
      <p class="mb-8 max-w-md text-[17px] text-zinc-600 dark:text-zinc-400">{t(locale, 'login.intro')}</p>
      <ul class="flex flex-col gap-4">
        {
          features.map((f) => (
            <li class="flex items-start gap-3.5">
              <span class="flex h-9 w-9 flex-none items-center justify-center rounded-[10px] border border-zinc-200 bg-white text-emerald-600 dark:border-zinc-800 dark:bg-zinc-900 dark:text-emerald-400">
                <Icon name={f.icon} class="h-[18px] w-[18px]" />
              </span>
              <span>
                <strong class="block font-semibold">{t(locale, f.title)}</strong>
                <span class="text-sm text-zinc-600 dark:text-zinc-400">{t(locale, f.text)}</span>
              </span>
            </li>
          ))
        }
      </ul>
    </section>

    <section
      aria-labelledby="signin-title"
      class="w-full max-w-[560px] min-w-0 flex-[1_1_520px] rounded-[20px] max-md:order-first border border-zinc-200 bg-white p-6 sm:p-8 dark:border-zinc-800 dark:bg-zinc-900"
    >
      <h2 id="signin-title" class="mb-1 text-[22px] font-semibold">{t(locale, 'login.title')}</h2>
      <p class="mb-6 text-sm text-zinc-600 dark:text-zinc-400">
        {t(locale, 'login.choose')}{' '}
        {t(locale, 'login.unsure')} <a href="/choose" class="font-semibold">{t(locale, 'login.helpMeChoose')} →</a>
      </p>

      <div class="flex flex-col gap-2.5">{primary.map((p) => <ProviderButton provider={p} variant="primary" />)}</div>

      {
        academic.length > 0 && (
          <>
            <h3 class="mt-7 mb-2.5 text-xs font-semibold tracking-wider text-zinc-600 uppercase dark:text-zinc-400">
              {t(locale, 'login.section.academic')}
            </h3>
            <div class="grid gap-2.5 sm:grid-cols-2">
              {academic.map((p) => (
                <ProviderButton provider={p} />
              ))}
            </div>
          </>
        )
      }

      {
        other.length > 0 && (
          <>
            <h3 class="mt-6 mb-2.5 text-xs font-semibold tracking-wider text-zinc-600 uppercase dark:text-zinc-400">
              {t(locale, 'login.section.other')}
            </h3>
            <div class="grid gap-2.5 sm:grid-cols-2">
              {other.map((p) => (
                <ProviderButton provider={p} />
              ))}
            </div>
          </>
        )
      }

      <div class="my-6 flex items-center gap-3">
        <span class="h-px flex-1 bg-zinc-200 dark:bg-zinc-800"></span>
        <span class="text-xs text-zinc-600 dark:text-zinc-400">{t(locale, 'login.or')}</span>
        <span class="h-px flex-1 bg-zinc-200 dark:bg-zinc-800"></span>
      </div>

      <button
        type="button"
        disabled
        class="flex min-h-12 w-full cursor-not-allowed items-center justify-center gap-2.5 rounded-xl border border-emerald-200 bg-emerald-50 font-semibold text-emerald-800 opacity-70 dark:border-emerald-800 dark:bg-emerald-950 dark:text-emerald-200"
      >
        <Icon name="key" class="h-[18px] w-[18px]" />
        {t(locale, 'login.passkeySoon')}
      </button>

      {
        soon.length > 0 && (
          <div class="mt-6 flex flex-wrap items-center gap-2 text-xs text-zinc-600 dark:text-zinc-400">
            <span>{t(locale, 'login.comingSoon')}</span>
            {soon.map((p) => (
              <span class="rounded-full border border-dashed border-zinc-300 px-2.5 py-0.5 dark:border-zinc-700">
                {providerLabel(locale, p).replace(/ \(.*\)$/, '')}
              </span>
            ))}
          </div>
        )
      }

      <div class="mt-5 flex gap-3 rounded-xl border border-zinc-200 bg-zinc-50 px-4 py-3.5 text-[13px] text-zinc-700 dark:border-zinc-800 dark:bg-zinc-950 dark:text-zinc-300">
        <Icon name="info" class="mt-0.5 h-4 w-4 flex-none text-emerald-600 dark:text-emerald-400" />
        <span><strong class="font-semibold">{t(locale, 'login.existing.title')}</strong> {t(locale, 'login.existing.text')}</span>
      </div>
    </section>
  </div>
</Base>
