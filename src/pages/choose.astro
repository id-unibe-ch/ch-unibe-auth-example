---
import Base from '../layouts/Base.astro';
import ProviderButton from '../components/ProviderButton.astro';
import { t, type UiKey } from '../i18n/ui';
import { getProvider, type ProviderDefinition } from '../lib/providers';

/**
 * The guided sign-in (ADR-017): "Who are you?" → a recommended method plus alternatives.
 * The choice travels as ?for=…, so the page works without JavaScript.
 */
if (Astro.locals.user) return Astro.redirect('/profile');
const { locale } = Astro.locals;

const personas = [
  { id: 'unibe', recommended: 'unibe', alternatives: ['microsoft', 'switch'] },
  { id: 'academic', recommended: 'switch', alternatives: ['microsoft', 'orcid', 'google'] },
  { id: 'research', recommended: 'orcid', alternatives: ['switch', 'github', 'microsoft'] },
  { id: 'other', recommended: 'external-id', alternatives: ['google', 'microsoft', 'github'] },
] as const;

const selected = personas.find((p) => p.id === Astro.url.searchParams.get('for'));
const resolve = (ids: readonly string[]) =>
  ids.map((id) => getProvider(id)).filter((p): p is ProviderDefinition => p?.status === 'available');
const recommended = selected ? resolve([selected.recommended])[0] : undefined;
const alternatives = selected ? resolve(selected.alternatives) : [];
const key = (id: string, part: 'title' | 'hint' | 'why') => `persona.${id}.${part}` as UiKey;
---

<Base titleKey="choose.title">
  <ol class="mb-6 flex flex-wrap gap-2 text-[13px]" aria-label={t(locale, 'choose.title')}>
    <li
      class:list={[
        'flex items-center gap-2 rounded-full border px-3 py-1.5',
        !selected
          ? 'border-emerald-300 bg-emerald-50 text-emerald-800 dark:border-emerald-800 dark:bg-emerald-950 dark:text-emerald-300'
          : 'border-zinc-300 text-zinc-700 dark:border-zinc-700 dark:text-zinc-300',
      ]}
      aria-current={!selected ? 'step' : undefined}
    >
      <span class="font-bold">1</span>
      {t(locale, 'choose.step1')}
    </li>
    <li
      class:list={[
        'flex items-center gap-2 rounded-full border px-3 py-1.5',
        selected
          ? 'border-emerald-300 bg-emerald-50 text-emerald-800 dark:border-emerald-800 dark:bg-emerald-950 dark:text-emerald-300'
          : 'border-zinc-300 text-zinc-700 dark:border-zinc-700 dark:text-zinc-300',
      ]}
      aria-current={selected ? 'step' : undefined}
    >
      <span class="font-bold">2</span>
      {t(locale, 'choose.step2')}
    </li>
  </ol>

  <h1 class="mb-2 text-3xl leading-tight font-bold tracking-tight sm:text-4xl">{t(locale, 'choose.heading')}</h1>
  <p class="mb-8 max-w-2xl text-base text-zinc-600 dark:text-zinc-400">{t(locale, 'choose.intro')}</p>

  <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
    {
      personas.map((p) => {
        const on = selected?.id === p.id;
        return (
          <li>
            <a
              href={`/choose?for=${p.id}#recommendation`}
              aria-current={on ? 'true' : undefined}
              class:list={[
                'block h-full min-h-24 rounded-2xl border-2 px-5 py-4 text-zinc-900 no-underline dark:text-zinc-100',
                on
                  ? 'border-emerald-500 bg-emerald-50 dark:border-emerald-400 dark:bg-emerald-950'
                  : 'border-zinc-200 bg-white hover:border-zinc-400 dark:border-zinc-800 dark:bg-zinc-900 dark:hover:border-zinc-600',
              ]}
            >
              <span class="mb-1 block text-base font-semibold">{t(locale, key(p.id, 'title'))}</span>
              <span class="block text-[13px] text-zinc-600 dark:text-zinc-400">{t(locale, key(p.id, 'hint'))}</span>
            </a>
          </li>
        );
      })
    }
  </ul>

  {
    selected ? (
      <section id="recommendation" class="mt-8 flex flex-wrap items-stretch gap-6" aria-labelledby="rec-title">
        <div class="min-w-0 flex-[1_1_420px] rounded-[20px] border border-zinc-200 bg-white p-7 dark:border-zinc-800 dark:bg-zinc-900">
          <h2 id="rec-title" class="mb-4 text-[13px] font-semibold tracking-wider text-emerald-700 uppercase dark:text-emerald-300">
            {t(locale, 'choose.recommended')}
          </h2>
          {recommended && <ProviderButton provider={recommended} variant="primary" />}
          <p class="mt-4 text-[13px] text-zinc-600 dark:text-zinc-400">{t(locale, key(selected.id, 'why'))}</p>
        </div>
        <div class="min-w-0 flex-[1_1_360px] rounded-[20px] border border-zinc-200 bg-white p-7 dark:border-zinc-800 dark:bg-zinc-900">
          <h2 class="mb-4 text-[13px] font-semibold tracking-wider text-zinc-600 uppercase dark:text-zinc-400">
            {t(locale, 'choose.alternatives')}
          </h2>
          <div class="flex flex-col gap-2.5">
            {alternatives.map((p) => (
              <ProviderButton provider={p} variant="compact" />
            ))}
          </div>
          <a href="/" class="mt-4 inline-block text-sm">
            {t(locale, 'choose.all')}
          </a>
        </div>
      </section>
    ) : (
      <p class="mt-8 text-sm text-zinc-600 dark:text-zinc-400">
        {t(locale, 'choose.pick')} <a href="/">{t(locale, 'choose.all')}</a>
      </p>
    )
  }
</Base>
