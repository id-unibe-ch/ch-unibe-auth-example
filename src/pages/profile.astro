---
import Base from '../layouts/Base.astro';
import ProviderButton from '../components/ProviderButton.astro';
import { getProvider, isEnabled, providers } from '../lib/providers';

const user = Astro.locals.user!;
const fmt = new Intl.DateTimeFormat('de-CH', { dateStyle: 'medium', timeStyle: 'short' });
const linkable = providers.filter((p) => p.status === 'available');
const anyLinkable = linkable.some(isEnabled);
---

<Base title="Profil">
  <h1 class="text-2xl font-bold">{user.displayName ?? 'Ihr Profil'}</h1>
  <p class="mt-1 text-sm text-neutral-500">
    {`Benutzerkonto erstellt am ${fmt.format(user.createdAt)} · ${user.identities.length} ${user.identities.length === 1 ? 'verbundener Account' : 'verbundene Accounts'}`}
  </p>

  <section class="mt-8">
    <h2 class="text-lg font-semibold">Verbundene Accounts</h2>
    <ul class="mt-3 space-y-3">
      {
        user.identities.map((identity) => {
          const provider = getProvider(identity.provider);
          return (
            <li class="rounded-lg border border-neutral-200 bg-white p-4 shadow-sm">
              <div class="flex flex-wrap items-start justify-between gap-3">
                <div>
                  <p class="font-medium">{provider?.label ?? identity.provider}</p>
                  <p class="text-sm text-neutral-600">
                    {identity.email ?? identity.subject}
                    {identity.email && identity.emailVerified === false && (
                      <span class="ml-1 text-xs text-amber-700">(nicht verifiziert)</span>
                    )}
                  </p>
                  <p class="mt-1 text-xs text-neutral-500">
                    Verbunden {fmt.format(identity.linkedAt)} · zuletzt angemeldet {fmt.format(identity.lastLoginAt)}
                  </p>
                </div>
                <form method="post" action="/account/unlink">
                  <input type="hidden" name="identityId" value={identity.id} />
                  <button
                    type="submit"
                    disabled={user.identities.length <= 1}
                    class="rounded-md border border-neutral-300 px-3 py-1.5 text-sm hover:bg-neutral-100 disabled:cursor-not-allowed disabled:opacity-40"
                  >
                    Trennen
                  </button>
                </form>
              </div>

              <details class="mt-3 text-sm">
                <summary class="cursor-pointer text-neutral-600 hover:text-neutral-900">Technische Details</summary>
                <dl class="mt-2 grid grid-cols-[max-content_1fr] gap-x-4 gap-y-1 text-xs">
                  <dt class="text-neutral-500">Issuer</dt>
                  <dd class="break-all font-mono">{identity.issuer}</dd>
                  <dt class="text-neutral-500">Subject</dt>
                  <dd class="break-all font-mono">{identity.subject}</dd>
                  <dt class="text-neutral-500">Protokoll</dt>
                  <dd>{provider?.protocol === 'oauth2' ? 'OAuth 2.0 (Profil über API)' : 'OpenID Connect (ID-Token)'}</dd>
                </dl>
                <pre class="mt-2 overflow-x-auto rounded bg-neutral-900 p-3 text-xs text-neutral-100">{JSON.stringify(identity.claims, null, 2)}</pre>
              </details>
            </li>
          );
        })
      }
    </ul>
  </section>

  <section class="mt-10">
    <h2 class="text-lg font-semibold">Weiteren Account verbinden</h2>
    <p class="mt-1 text-sm text-neutral-600">
      Melden Sie sich beim gewünschten Provider an, um zu bestätigen, dass Ihnen der Account gehört.
    </p>
    {
      anyLinkable ? (
        <div class="mt-3 grid gap-3 sm:grid-cols-2">
          {linkable.map((p) => <ProviderButton provider={p} intent="link" />)}
        </div>
      ) : (
        <p class="mt-3 text-sm text-neutral-500">Es sind keine weiteren Provider konfiguriert.</p>
      )
    }
  </section>

  <section class="mt-10 border-t border-neutral-200 pt-6">
    <h2 class="text-lg font-semibold text-red-800">Konto löschen</h2>
    <p class="mt-1 text-sm text-neutral-600">Löscht Ihr Benutzerkonto und alle verbundenen Accounts in dieser Anwendung.</p>
    <form method="post" action="/account/delete" class="mt-3">
      <button
        type="submit"
        class="rounded-md border border-red-300 px-3 py-1.5 text-sm text-red-800 hover:bg-red-50"
      >
        Konto löschen
      </button>
    </form>
  </section>
</Base>
