---
/**
 * The University of Bern logo.
 *
 * Carried as path data rather than as a file in `public/` for the same reason
 * as the aside icons and the task-list checkboxes: it is drawn in
 * `currentColor`, so one mark works in both themes and inside Starlight's
 * header as well as the Tailwind one. An `<img>` would need a light and a dark
 * copy and a second request.
 *
 * Copied from ch-unibe-learning-astro.
 *
 * The mark is a wordmark — it says "Universität Bern" itself, which is why no
 * site name is set beside it. The link that wraps it carries the accessible
 * name.
 */
interface Props {
	class?: string;
}

const { class: className } = Astro.props;
---

