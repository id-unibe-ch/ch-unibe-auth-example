---
/**
 * The providers' marks, drawn inline on a white tile so they keep their brand colours in both themes.
 *
 * Sources:
 * - Microsoft: the four-square logo as specified in Microsoft's sign-in branding guidelines.
 * - Google: the standard "G" from Google's sign-in branding guidelines.
 * - GitHub: the Invertocat mark from GitHub's logo guidelines.
 * - ORCID: the iD icon from orcid.org (assets/vectors/orcid.logo.icon.svg).
 * - SWITCH edu-ID: the iD mark from static.eduid.ch (favicon.svg).
 * - UniBE: the university's u^b mark, drawn in the accent colour.
 * Before going public, check each against the provider's current brand guidelines.
 */
import Icon from './Icon.astro';

interface Props {
  id: string;
  size?: 'sm' | 'md' | 'lg';
}

const { id, size = 'md' } = Astro.props;
const box = { sm: 'h-7 w-7 rounded-md', md: 'h-8 w-8 rounded-lg', lg: 'h-10 w-10 rounded-[10px]' }[size];
const mark = { sm: 'h-4 w-4', md: 'h-[18px] w-[18px]', lg: 'h-6 w-6' }[size];
---

{
  id === 'unibe' ? (
    <span class:list={['flex flex-none items-center justify-center bg-emerald-950 text-emerald-400 font-bold dark:bg-emerald-950', box]} aria-hidden="true">
      <span class="text-[13px] leading-none">
        u<sup class="text-[8px]">b</sup>
      </span>
    </span>
  ) : (
    <span class:list={['flex flex-none items-center justify-center bg-white ring-1 ring-zinc-200 dark:ring-0', box]} aria-hidden="true">
      {id === 'microsoft' && (
        <svg class={mark} viewBox="0 0 23 23">
          <rect x="1" y="1" width="10" height="10" fill="#f25022" />
          <rect x="12" y="1" width="10" height="10" fill="#7fba00" />
          <rect x="1" y="12" width="10" height="10" fill="#00a4ef" />
          <rect x="12" y="12" width="10" height="10" fill="#ffb900" />
        </svg>
      )}
      {id === 'google' && (
        <svg class={mark} viewBox="0 0 48 48">
          <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z" />
          <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z" />
          <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z" />
          <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z" />
        </svg>
      )}
      {id === 'github' && (
        <svg class={mark} viewBox="0 0 16 16">
          <path fill="#18181b" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z" />
        </svg>
      )}
      {id === 'orcid' && (
        <svg class={mark} viewBox="0 0 72 72">
          <path fill="#A6CE39" d="M72 36c0 19.88-16.12 36-36 36S0 55.88 0 36 16.12 0 36 0s36 16.12 36 36z" />
          <g fill="#FFFFFF" transform="translate(18.87 12.91)">
            <polygon points="5.04 39.13 0.7 39.13 0.7 9.14 5.04 9.14 5.04 22.69 5.04 39.13" />
            <path d="M11.41 9.14h11.73c11.17 0 16.07 7.92 16.07 15.01 0 7.7-6.06 15-16.01 15H11.41V9.14zm4.34 26.12h6.91c9.84 0 12.1-7.42 12.1-11.11 0-6.02-3.86-11.11-12.32-11.11h-6.69v22.22z" />
            <path d="M5.71 2.9c0 1.54-1.27 2.83-2.85 2.83S.02 4.44.02 2.9C.02 1.33 1.29.07 2.87.07S5.71 1.36 5.71 2.9z" />
          </g>
        </svg>
      )}
      {id === 'switch' && (
        <svg class={mark} viewBox="0 0 16 16">
          <path fill="#31749e" d="M2.73 3.76h1.9v9.29h-1.9V3.76z" />
          <path fill="#31749e" d="M6.71 3.76h3.07c2.68 0 4.79 2.05 4.79 4.65s-2.11 4.64-4.79 4.64H6.71V3.76zm3.07 7.55c1.72 0 2.87-1.3 2.87-2.9S11.5 5.5 9.78 5.5H8.61v5.81h1.17z" />
        </svg>
      )}
      {id === 'external-id' && <Icon name="mail" class:list={[mark, 'text-emerald-700']} />}
      {!['microsoft', 'google', 'github', 'orcid', 'switch', 'external-id'].includes(id) && (
        <span class="text-[10px] font-bold text-zinc-700">{id.slice(0, 2).toUpperCase()}</span>
      )}
    </span>
  )
}
