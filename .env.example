# Öffentliche Basis-URL der App (ohne Slash am Ende). Daraus werden die Redirect-URIs gebildet:
#   {APP_BASE_URL}/auth/{provider}/callback
APP_BASE_URL=http://localhost:4321

# --- Entra ID: UniBE-Tenant (Mitarbeitende und Studierende) ---
# Standard: d400387a-212f-43ea-ac7f-77aa12d7977e (unibe.ch)
ENTRA_UNIBE_TENANT_ID=
ENTRA_UNIBE_CLIENT_ID=
ENTRA_UNIBE_CLIENT_SECRET=

# --- Microsoft: persönliche Konten + alle Entra-Tenants (common) ---
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# --- Entra External ID (Broker): unibeeid.onmicrosoft.com ---
# Standard: a791c572-76d6-4480-83df-b81dcdb92f69 (unibeeid.onmicrosoft.com)
EXTERNAL_ID_TENANT_ID=
EXTERNAL_ID_CLIENT_ID=
EXTERNAL_ID_CLIENT_SECRET=

# --- SWITCH edu-ID / SWITCHaai ---
SWITCH_CLIENT_ID=
SWITCH_CLIENT_SECRET=

# --- ORCID (für Tests: ORCID_ISSUER=https://sandbox.orcid.org) ---
ORCID_ISSUER=https://orcid.org
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=

# --- Google ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- GitHub (OAuth 2.0) ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- AGOV (Zugang noch offen) ---
AGOV_ISSUER=
AGOV_CLIENT_ID=
AGOV_CLIENT_SECRET=
