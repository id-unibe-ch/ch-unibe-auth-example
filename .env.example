# Öffentliche Basis-URL der App (ohne Slash am Ende). Daraus werden die Redirect-URIs gebildet:
#   {APP_BASE_URL}/auth/{provider}/callback
APP_BASE_URL=http://localhost:4321

# --- Datenbank (Azure SQL bzw. lokal SQL Server aus docker-compose.yml) ---
# Ohne SQL_SERVER/SQL_DATABASE läuft die App mit einem In-Memory-Speicher (Daten gehen beim Neustart verloren).
#
# Lokal (Docker):
SQL_SERVER=localhost
SQL_DATABASE=authexample
SQL_AUTH=sql
SQL_USER=sa
SQL_PASSWORD=Dev_Passw0rd!
#
# Azure (Managed Identity, kein Passwort):
# SQL_SERVER=<server>.database.windows.net
# SQL_DATABASE=<datenbank>
# SQL_AUTH=entra
# AZURE_CLIENT_ID=<Client-ID der user-assigned Managed Identity, falls verwendet>

# --- Entra ID: UniBE-Tenant (Mitarbeitende und Studierende) ---
# Standard: d400387a-212f-43ea-ac7f-77aa12d7977e (unibe.ch)
ENTRA_UNIBE_TENANT_ID=
# App: «UniBE - IDCI - Auth Example App (UniBE)»
ENTRA_UNIBE_CLIENT_ID=22c30b53-85f0-4da8-b68b-8c0c2340904a
ENTRA_UNIBE_CLIENT_SECRET=

# --- Microsoft: persönliche Konten + alle Entra-Tenants (common) ---
# App: «UniBE - IDCI - Auth Example App (All Tenants)», registriert im UniBE-Tenant
MICROSOFT_CLIENT_ID=b048dae9-05c7-4e86-a5c2-ac955c3c26bf
MICROSOFT_CLIENT_SECRET=

# --- Entra External ID (Broker): unibeeid.onmicrosoft.com ---
# Standard: a791c572-76d6-4480-83df-b81dcdb92f69 (unibeeid.onmicrosoft.com)
EXTERNAL_ID_TENANT_ID=
# App: «UniBE - IDCI - Auth Example App (eID)»
EXTERNAL_ID_CLIENT_ID=20bf5a5b-79a0-40e2-abcb-828224942804
EXTERNAL_ID_CLIENT_SECRET=

# --- SWITCH edu-ID / SWITCHaai ---
SWITCH_CLIENT_ID=
SWITCH_CLIENT_SECRET=

# --- ORCID (für Tests: ORCID_ISSUER=https://sandbox.orcid.org) ---
ORCID_ISSUER=https://orcid.org
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=

# --- Google ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- GitHub (OAuth 2.0) ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- AGOV (Zugang noch offen) ---
AGOV_ISSUER=
AGOV_CLIENT_ID=
AGOV_CLIENT_SECRET=
