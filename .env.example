# Public base URL of the app (no trailing slash). The redirect URIs are built from it:
#   {APP_BASE_URL}/auth/{provider}/callback
APP_BASE_URL=http://localhost:4321

# --- Database (Azure SQL, or locally SQL Server from docker-compose.yml) ---
# Without SQL_SERVER/SQL_DATABASE the app runs with an in-memory store (data is lost on restart).
#
# Local (Docker):
SQL_SERVER=localhost
SQL_DATABASE=authexample
SQL_AUTH=sql
SQL_USER=sa
SQL_PASSWORD=Dev_Passw0rd!
#
# Azure (managed identity, no password):
# SQL_SERVER=<server>.database.windows.net
# SQL_DATABASE=<database>
# SQL_AUTH=entra
# AZURE_CLIENT_ID=<client id of the user-assigned managed identity, if used>

# --- Entra ID: UniBE tenant (staff and students) ---
# Default: d400387a-212f-43ea-ac7f-77aa12d7977e (unibe.ch)
ENTRA_UNIBE_TENANT_ID=
# App: "UniBE - IDCI - Auth Example App (UniBE)"
ENTRA_UNIBE_CLIENT_ID=22c30b53-85f0-4da8-b68b-8c0c2340904a
ENTRA_UNIBE_CLIENT_SECRET=

# --- Microsoft: personal accounts + all Entra tenants (common) ---
# App: "UniBE - IDCI - Auth Example App (All Tenants)", registered in the UniBE tenant
MICROSOFT_CLIENT_ID=b048dae9-05c7-4e86-a5c2-ac955c3c26bf
MICROSOFT_CLIENT_SECRET=

# --- Entra External ID (broker): unibeeid.onmicrosoft.com ---
# Default: a791c572-76d6-4480-83df-b81dcdb92f69 (unibeeid.onmicrosoft.com)
EXTERNAL_ID_TENANT_ID=
# App: "UniBE - IDCI - Auth Example App (eID)"
EXTERNAL_ID_CLIENT_ID=20bf5a5b-79a0-40e2-abcb-828224942804
EXTERNAL_ID_CLIENT_SECRET=

# --- SWITCH edu-ID / SWITCHaai ---
SWITCH_CLIENT_ID=
SWITCH_CLIENT_SECRET=

# --- ORCID (for tests: ORCID_ISSUER=https://sandbox.orcid.org) ---
ORCID_ISSUER=https://orcid.org
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=

# --- Google ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- GitHub (OAuth 2.0) ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- AGOV (access still open) ---
AGOV_ISSUER=
AGOV_CLIENT_ID=
AGOV_CLIENT_SECRET=
